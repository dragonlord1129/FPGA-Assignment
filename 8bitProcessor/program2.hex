//  00: LDI 10        03 0A
//  02: CALL DOUBLE(0x0C)   0F 0C
//  04: OUT                 11
//  05: PUSH                1A
//  06: LDI 99         03 63
//  08: POP                 1B      ; A restored to previous OUT value
//  09: OUT                 11
//  0A: HLT                 FF
//  0B: (pad)          00
//  0C: DOUBLE: ADD 0x0C? -- instead do ADI 10 (double via add-immediate of self? use ADI with OPR=A not possible)
//      simpler: DOUBLE: SHL ; RET
//  0C: SHL                 18
//  0D: RET                 10
@00
03 0A 0F 0C 11 1A 03 63 1B 11 FF 00 18 10
